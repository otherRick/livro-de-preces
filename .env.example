# Copie para .env.local e preencha. NUNCA versione valores reais.
# Tudo aqui é lido APENAS no servidor ($env/dynamic/private).
# Nenhuma destas variáveis pode virar PUBLIC_*, exceto onde indicado.

# --- Supabase (Tarefa 1 e 2) ---
# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
SUPABASE_URL=
# service_role key: só no servidor. Se vazar, o banco inteiro vaza.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segredos de hash (Tarefa 2) ---
# Chaves HMAC. Gere com: openssl rand -hex 32
SEGREDO_SESSAO=
SEGREDO_IP=

# --- Cloudflare Turnstile (Tarefa 2) ---
# A sitekey é pública por natureza (vai ao HTML via +page.server.ts).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# --- Administração (Tarefa 4) ---
# Senha única do painel do dono.
ADMIN_SENHA=

# --- Operação (Tarefa 6) ---
# Token do ping anti-pausa e do backup agendado.
CRON_SECRET=
